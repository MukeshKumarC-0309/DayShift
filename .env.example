# Copy to .env only if you want to override something. Dayshift runs with no
# .env at all — your username and passcode are set on first run, in the app.

# Optional. Pins the session signing secret. Leave it unset and one is
# generated during setup and stored in auth.json.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Setting this means a passcode change will NOT sign out existing sessions.
JWT_SECRET=

# First day of tracking. Par scores ignore anything before this date.
TRACKING_START_DATE=2026-10-01

# Origin of the Vite dev server, for CORS during direct-to-backend debugging.
FRONTEND_ORIGIN=http://localhost:5173

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Hosting (leave unset for local use) --------------------------------------

# Where the database, auth.json and backups live. Point at a persistent volume.
# DATA_DIR=/data

# Send the session cookie over HTTPS only. Set true when hosted.
# COOKIE_SECURE=true

# Required to complete first-run setup when the site is public, so nobody else
# can claim your login before you do.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# SETUP_TOKEN=
